# ========================================================
# SECTION 1: PROJECT SECURITY & DATA (NON-NEGOTIABLE)
# ========================================================

# 1) Secrets / env
.env
.env.*
!.env.example

# 2) Local data (policy: no raw/PII in git)
data/raw/
data/private/
data/clean/
data/exports/
data/tmp/
data/cache/

# Allow small, anonymized samples
!data/samples/
!data/samples/**

# If someone accidentally creates these anywhere:
**/*_raw.*
**/*raw_export.*
**/*forms_export.*
**/*survey_export.*
**/*interview_notes.*
**/*pii.*

# Common data files (Block EVERYTHING large by default)
*.csv
*.tsv
*.xlsx
*.xls
*.json
*.jsonl
*.parquet
*.feather
*.avro
*.zip

# ...BUT allow mapping files in sql/mappings (small, versioned)
!sql/mappings/**/*.csv
!sql/mappings/**/*.tsv
!sql/mappings/**/*.json
!sql/mappings/**/*.jsonl

# 3) Databases / volumes
*.db
*.sqlite
*.sqlite3
*.duckdb
pgdata/
postgres-data/
docker-data/
*.dump
*.backup

# ========================================================
# SECTION 2: PYTHON & ENVIRONMENT
# ========================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments (UV, Venv, etc)
.venv/
venv/
env/
.Python
build/
dist/
*.egg-info/
.installed.cfg
*.egg

# Testing & Linting
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# ========================================================
# SECTION 3: OS & EDITOR CONFIGS
# ========================================================
.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp

# ========================================================
# SECTION 4: TOOL SPECIFIC (PRESERVED FROM ORIGINAL)
# ========================================================

# Power BI
*.pbix
*.pbit

# Marimo (Repo owner tools)
marimo/_static/
marimo/_lsp/
__marimo__/

# Cursor
.cursorignore
.cursorindexingignore

# Logs
*.log
logs/
*.tmp